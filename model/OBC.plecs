          }
          Component {
            Type          CScript
            Name          "Gate Generator"
            Show          on
            Position      [250, 150]
            Direction     right
            Flipped       off
            LabelPosition south
            Parameter {
              Variable      "DialogGeometry"
              Value         "[100 100 700 600]"
              Show          off
            }
            Parameter {
              Variable      "NumInputs"
              Value         "1"
              Show          off
            }
            Parameter {
              Variable      "NumOutputs"
              Value         "9"
              Show          off
            }
            Parameter {
              Variable      "NumContStates"
              Value         "0"
              Show          off
            }
            Parameter {
              Variable      "NumDiscStates"
              Value         "0"
              Show          off
            }
            Parameter {
              Variable      "NumZCSignals"
              Value         "0"
              Show          off
            }
            Parameter {
              Variable      "DirectFeedthrough"
              Value         "0"
              Show          off
            }
            Parameter {
              Variable      "Ts"
              Value         "[0, -1; -2, 0]"
              Show          off
            }
            Parameter {
              Variable      "TerminalBasedSampleTimes"
              Value         "1"
              Show          off
            }
            Parameter {
              Variable      "Parameters"
              Value         "CTRL.Vset, CTRL.Kp_llc, CTRL.Ki_llc, CTRL.f_min, "
"CTRL.f_max, CTRL.t_llc_en, CTRL.slew_llc, CTRL.T_dt_llc, 1, CTRL.f_llc"
              Show          off
            }
            Parameter {
              Variable      "LangStandard"
              Value         "2"
              Show          off
            }
            Parameter {
              Variable      "GnuExtensions"
              Value         "2"
              Show          off
            }
            Parameter {
              Variable      "RuntimeCheck"
              Value         "2"
              Show          off
            }
            Parameter {
              Variable      "HighlightLevel"
              Value         "0"
              Show          off
            }
            Parameter {
              Variable      "Declarations"
              Value         "#include <float.h>\n"
"#define VOUT InputSignal(0, 0)\n"
"static int    phase;                  /* -1 off, 0 diagonal 1 on, 1 dead time"
", 2 diagonal 2 on, 3 dead time */\n"
"static double f, integ, vref, vmeas, tnext;\n"
"static double Vset, Kp, Ki, fmin, fmax, ten, slew, tdt, mode, fol;"
              Show          off
            }
            Parameter {
              Variable      "StartFcn"
              Value         "Vset = ParamRealData(0,0); Kp   = ParamRealData(1"
",0); Ki   = ParamRealData(2,0);\n"
"fmin = ParamRealData(3,0); fmax = ParamRealData(4,0); ten  = ParamRealData(5,"
"0);\n"
"slew = ParamRealData(6,0); tdt  = ParamRealData(7,0); mode = ParamRealData(8,"
"0); fol = ParamRealData(9,0);\n"
"phase = -1; f = (mode < 1.5) ? fmax : fol; integ = 0; vref = 0; vmeas = 0; tn"
"ext = ten;"
              Show          off
            }
            Parameter {
              Variable      "OutputFcn"
              Value         "int k;\n"
"double t = CurrentTime;\n"
"if (IsSampleHit(1) && t >= tnext) {                  /* gate edge (task 1 = v"
"ariable sample time) */\n"
"   if (phase < 0 || phase == 3) {                    /* start of a switching "
"period: control update */\n"
"      if (mode < 1.5) {                              /* 1: output voltage PI "
"-> frequency (LLC gain falls with f) */\n"
"         double e, u, fc;\n"
"         if (phase < 0) vref = vmeas;                /* soft start from the a"
"ctual output voltage */\n"
"         if (vref < Vset) { vref += slew / f; if (vref > Vset) vref = Vset; }"
"\n"
"         else             { vref -= slew / f; if (vref < Vset) vref = Vset; }"
"\n"
"         e      = vref - vmeas;\n"
"         integ += Ki * e / f;\n"
"         u      = Kp * e + integ;\n"
"         fc     = fmax - u;\n"
"         if (fc < fmin)      { fc = fmin; integ = fmax - fmin - Kp * e; }   /"
"* anti-windup */\n"
"         else if (fc > fmax) { fc = fmax; integ = -Kp * e; }\n"
"         f = fc;\n"
"      } else {\n"
"         f = fol;                                    /* 2: fixed frequency */"
"\n"
"      }\n"
"      phase = 0; tnext = t + 0.5 / f - tdt;\n"
"   }\n"
"   else if (phase == 0) { phase = 1; tnext = t + tdt; }\n"
"   else if (phase == 1) { phase = 2; tnext = t + 0.5 / f - tdt; }\n"
"   else                 { phase = 3; tnext = t + tdt; }\n"
"}\n"
"NextSampleHit = (tnext > t) ? tnext : t * (1. + DBL_EPSILON);\n"
"for (k = 0; k < 8; k++) OutputSignal(0, k) = 0;\n"
"if (phase == 0)      { OutputSignal(0, 0) = 1; OutputSignal(0, 3) = 1; Output"
"Signal(0, 4) = 1; OutputSignal(0, 7) = 1; }\n"
"else if (phase == 2) { OutputSignal(0, 1) = 1; OutputSignal(0, 2) = 1; Output"
"Signal(0, 5) = 1; OutputSignal(0, 6) = 1; }\n"
"OutputSignal(0, 8) = f;"
              Show          off
            }
            Parameter {
              Variable      "UpdateFcn"
              Value         "vmeas = VOUT;                                    "
"    /* output voltage used at the next period start */"
              Show          off
            }
            Parameter {
              Variable      "DerivativeFcn"
              Value         ""
              Show          off
            }
            Parameter {
              Variable      "TerminateFcn"
              Value         ""
              Show          off
            }
            Parameter {
              Variable      "StoreCustomStateFcn"
              Value         ""
              Show          off
            }
            Parameter {
              Variable      "RestoreCustomStateFcn"
              Value         ""
              Show          off
            }
          }
