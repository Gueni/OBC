      Location      [300, 200; 1000, 600]
      ZoomFactor    1
      SliderPosition [0, 0]
      ShowBrowser   off
      BrowserWidth  100
      Configurations {
        Name          "VF PI (output voltage)"
        Schematic {
          Component {
            Type          Input
            Name          "Vo"
            Show          on
            Position      [100, 150]
            Direction     right
            Flipped       off
            LabelPosition south
            Parameter {
